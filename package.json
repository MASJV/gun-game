{
  "name": "shadow-protocol",
  "version": "2.4.1",
  "license": "MIT",
  "private": true,
  "description": "SHADOW PROTOCOL - tactical browser FPS (Three.js): solo missions, tactical enemy AI and 2-4 player LAN co-op",
  "scripts": {
    "build": "esbuild src/main.js --bundle --minify --format=iife --outfile=dist/game.js",
    "dev": "esbuild src/main.js --bundle --format=iife --outfile=dist/game.js --watch --servedir=.",
    "assets": "node tools/build-assets.mjs",
    "test": "node tools/test.cjs",
    "perf": "node tools/perf.cjs",
    "smoke": "node tools/smoke.cjs",
    "pace": "node tools/pace.cjs",
    "feel": "node tools/feel.cjs",
    "e2e": "node tools/e2e.cjs",
    "lan": "node server/lan.cjs",
    "mptest": "node tools/mp-test.cjs",
    "servertest": "node tools/server-test.cjs"
  },
  "dependencies": {
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@gltf-transform/core": "^4.5.1",
    "@gltf-transform/extensions": "^4.5.1",
    "@gltf-transform/functions": "^4.5.1",
    "esbuild": "^0.25.0",
    "meshoptimizer": "^1.3.0",
    "playwright": "1.63.0",
    "sharp": "^0.35.5"
  },
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/MASJV/shadow-protocol.git"
  }
}
